@model DAS_FASE2.ViewModels.UsuarioViewModel

@{
    ViewData["Title"] = "Editar Usuario";
}

<div class="container mt-4">
    <h2>Editar Usuario</h2>
    <hr />

    <form asp-action="Edit" method="post">
        @Html.AntiForgeryToken()
        
        <input type="hidden" asp-for="IdUsuario" />

        <div asp-validation-summary="ModelOnly" class="text-danger"></div>

        <div class="mb-3">
            <label asp-for="Nombre" class="form-label"></label>
            <input asp-for="Nombre" class="form-control" />
            <span asp-validation-for="Nombre" class="text-danger"></span>
        </div>

        <div class="mb-3">
            <label asp-for="Correo" class="form-label"></label>
            <input asp-for="Correo" class="form-control" />
            <span asp-validation-for="Correo" class="text-danger"></span>
        </div>

        <div class="mb-3">
            <label asp-for="Password" class="form-label">Nueva Contraseña (Opcional)</label>
            <input asp-for="Password" type="password" class="form-control" />
            <span asp-validation-for="Password" class="text-danger"></span>
        </div>

        <div class="mb-3">
            <label asp-for="Rol" class="form-label"></label>
            <select asp-for="Rol" class="form-control">
                <option value="Administrador">Administrador</option>
                <option value="Operativo">Operativo</option>
            </select>
            <span asp-validation-for="Rol" class="text-danger"></span>
        </div>

        <button type="submit" class="btn btn-primary">Actualizar Cambios</button>
        <a asp-action="Index" class="btn btn-secondary">Cancelar</a>
    </form>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}