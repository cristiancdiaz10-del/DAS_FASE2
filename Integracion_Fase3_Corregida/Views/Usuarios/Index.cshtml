@model IEnumerable<DAS_Proyecto.Models.Usuario>

@{
    ViewData["Title"] = "Gestión de usuarios";
}

<div class="max-w-6xl mx-auto">
    <div class="flex flex-wrap items-center justify-between gap-4 mb-6">
        <div>
            <h1 class="text-2xl font-extrabold text-gray-900">Gestión de usuarios</h1>
            <p class="text-sm text-gray-500 mt-1">Administra las cuentas y los roles del sistema.</p>
        </div>
        <a asp-action="Create" class="rounded-lg bg-amber-500 hover:bg-amber-600 text-white font-semibold px-4 py-2">+ Nuevo usuario</a>
    </div>

    @if (TempData["MensajeExito"] is string exito)
    {
        <div class="mb-4 rounded-lg bg-green-50 text-green-800 p-3">@exito</div>
    }
    @if (TempData["MensajeError"] is string error)
    {
        <div class="mb-4 rounded-lg bg-red-50 text-red-800 p-3">@error</div>
    }

    <div class="rounded-xl border border-gray-200 bg-white p-5 shadow-sm">
        <form asp-action="Index" method="get" class="flex flex-wrap gap-3 mb-4">
            <input type="search" name="busqueda" value="@(ViewBag.Busqueda ?? "")" placeholder="Buscar por nombre, correo o rol..." class="border border-gray-300 rounded-lg px-3 py-2 min-w-[260px] flex-1" />
            <button type="submit" class="rounded-lg bg-gray-800 text-white px-4 py-2 font-semibold">Buscar</button>
            <a asp-action="Index" class="rounded-lg border border-gray-300 px-4 py-2">Limpiar</a>
        </form>

        <div class="overflow-x-auto">
            <table class="w-full text-sm text-left">
                <thead class="text-xs uppercase text-gray-500 border-b">
                    <tr><th class="py-3 px-3">Nombre</th><th class="py-3 px-3">Correo</th><th class="py-3 px-3">Rol</th><th class="py-3 px-3 text-right">Acciones</th></tr>
                </thead>
                <tbody>
                @if (Model.Any())
                {
                    foreach (var usuario in Model)
                    {
                        <tr class="border-b last:border-0 hover:bg-gray-50">
                            <td class="py-3 px-3 font-semibold">@usuario.Nombre</td>
                            <td class="py-3 px-3">@usuario.Correo</td>
                            <td class="py-3 px-3">@usuario.Rol</td>
                            <td class="py-3 px-3 text-right whitespace-nowrap">
                                <a asp-action="Edit" asp-route-id="@usuario.IdUsuario" class="text-blue-600 font-semibold">Editar</a>
                                <form asp-action="Delete" asp-route-id="@usuario.IdUsuario" method="post" class="inline" onsubmit="return confirm('¿Eliminar este usuario?');">
                                    @Html.AntiForgeryToken()
                                    <button type="submit" class="ml-3 text-red-600 font-semibold">Eliminar</button>
                                </form>
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr><td colspan="4" class="py-8 text-center text-gray-500">No hay usuarios que coincidan con la búsqueda.</td></tr>
                }
                </tbody>
            </table>
        </div>
    </div>
</div>
