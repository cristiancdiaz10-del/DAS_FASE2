@model DAS_Proyecto.ViewModels.DashboardViewModel
@using DAS_Proyecto.Models
@{ ViewData["Title"] = "Dashboard"; }
<style>
.title{font-size:1.9rem;font-weight:800;color:#111827}.subtitle{color:#6b7280;margin-bottom:1.5rem}.metrics{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:1rem;margin-bottom:1.6rem}.metric{background:#fff;border:1px solid #e5e7eb;border-radius:.8rem;padding:1.25rem}.metric-label{color:#64748b;font-size:.85rem;font-weight:700}.metric-value{font-size:2rem;font-weight:800;color:#111827;margin:.4rem 0}.panel{background:#fff;border:1px solid #e5e7eb;border-radius:.8rem;padding:1.4rem}.table{width:100%;border-collapse:collapse}.table th,.table td{text-align:left;padding:.8rem;border-bottom:1px solid #f1f5f9}.table th{font-size:.75rem;color:#64748b;text-transform:uppercase}.link{color:#2563eb;text-decoration:none;font-weight:600}@@media(max-width:900px){.metrics{grid-template-columns:1fr 1fr}}@@media(max-width:600px){.metrics{grid-template-columns:1fr}.panel{overflow-x:auto}.table{min-width:550px}}
</style>
<h1 class="title">Dashboard</h1><p class="subtitle">Resumen del negocio calculado a partir de la información almacenada en SQL Server.</p>
<div class="metrics"><div class="metric"><div class="metric-label">Órdenes registradas</div><div class="metric-value">@Model.TotalOrdenes</div><div class="metric-label">Total histórico</div></div><div class="metric"><div class="metric-label">En proceso</div><div class="metric-value">@Model.OrdenesEnProceso</div><div class="metric-label">En producción</div></div><div class="metric"><div class="metric-label">Cotizaciones pendientes</div><div class="metric-value">@Model.CotizacionesPendientes</div><div class="metric-label">Esperando respuesta</div></div><div class="metric"><div class="metric-label">Ingresos del mes</div><div class="metric-value" style="font-size:1.7rem">@Model.IngresosDelMes.ToString("C2")</div><div class="metric-label">Pagos registrados este mes</div></div></div>
<div class="panel"><h2 style="font-weight:800;margin-bottom:1rem">Órdenes recientes</h2><table class="table"><thead><tr><th>Código</th><th>Cliente</th><th>Fecha</th><th>Estado</th><th></th></tr></thead><tbody>@if(Model.OrdenesRecientes.Count==0){<tr><td colspan="5" style="color:#64748b">Todavía no hay órdenes registradas.</td></tr>}else{foreach(var orden in Model.OrdenesRecientes){<tr><td><strong>@orden.CodigoOrden</strong></td><td>@orden.Cotizacion?.Cliente?.Nombre</td><td>@orden.FechaOrden.ToString("dd/MM/yyyy")</td><td>@orden.Estado</td><td><a asp-controller="Ordenes" asp-action="Detalle" asp-route-id="@orden.IdOrdenTrabajo" class="link">Ver</a></td></tr>}}</tbody></table></div>
