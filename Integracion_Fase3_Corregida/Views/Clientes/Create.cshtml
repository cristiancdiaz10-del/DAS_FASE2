@model DAS_Proyecto.ViewModels.ClienteViewModel

@{
    ViewData["Title"] = "Registrar Cliente";
}

<style>
    .header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 1rem;
        margin-bottom: 1.5rem;
    }

    .title {
        font-size: 1.75rem;
        font-weight: 800;
        color: #111827;
        margin-bottom: 0.25rem;
    }

    .sub {
        color: #6b7280;
        font-size: .9rem;
        margin-bottom: 0;
    }

    .panel {
        background: #fff;
        border: 1px solid #e5e7eb;
        border-radius: .75rem;
        padding: 1.5rem;
    }

    .custom-cancel:hover {
        background-color: #e9ecef !important;
        border-color: #adb5bd !important;
        transform: translateY(-1px);
    }

    .custom-save:hover {
        background-color: #e68a00 !important;
        border-color: #e68a00 !important;
        transform: translateY(-1px);
    }

    @@media(max-width:700px) {
        .header {
            align-items: flex-start;
            flex-direction: column;
        }
    }
</style>

<div class="header">
    <div>
        <h1 class="title">Registrar Nuevo Cliente</h1>
        <p class="sub">Registra la información del cliente para gestionar sus cotizaciones y órdenes de trabajo.</p>
    </div>
</div>


<div class="panel">
    <form asp-action="Create" method="post">
        @Html.AntiForgeryToken()

        <div asp-validation-summary="ModelOnly" class="text-danger"></div>

        <div class="mb-3">
            <label asp-for="Nombre" class="form-label"></label>
            <input asp-for="Nombre" class="form-control" />
            <span asp-validation-for="Nombre" class="text-danger"></span>
        </div>

        <div class="mb-3">
            <label asp-for="Telefono" class="form-label"></label>
            <input asp-for="Telefono" class="form-control" />
            <span asp-validation-for="Telefono" class="text-danger"></span>
        </div>

        <div class="mb-3">
            <label asp-for="Correo" class="form-label"></label>
            <input asp-for="Correo" class="form-control" />
            <span asp-validation-for="Correo" class="text-danger"></span>
        </div>

        <div class="mb-3">
            <label asp-for="Empresa" class="form-label"></label>
            <input asp-for="Empresa" class="form-control" />
        </div>

        <div class="mb-3">
            <label asp-for="Direccion" class="form-label"></label>
            <input asp-for="Direccion" class="form-control" />
        </div>

        <div class="mb-3">
            <label asp-for="Observaciones" class="form-label"></label>
            <textarea asp-for="Observaciones" class="form-control" rows="3"></textarea>
        </div>

     
        <div style="display: flex; gap: 12px; margin-top: 1.5rem;">
            <a asp-action="Index" class="btn btn-light border py-2 rounded-pill shadow-sm text-center text-dark custom-cancel" style="flex: 1; font-weight: 500; text-decoration: none; display: flex; align-items: center; justify-content: center; transition: all 0.2s ease-in-out;">
                Cancelar
            </a>
            <button type="submit" class="btn py-2 rounded-pill text-dark fw-bold shadow-sm custom-save" style="flex: 1; background-color: #ff9900; border-color: #ff9900; transition: all 0.2s ease-in-out;">
                Guardar cliente
            </button>
        </div>
    </form>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}