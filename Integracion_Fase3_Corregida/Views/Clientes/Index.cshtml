@model IEnumerable<DAS_Proyecto.Models.Cliente>
@{ ViewData["Title"] = "Clientes"; }
<style>
.header{display:flex;justify-content:space-between;align-items:center;gap:1rem;margin-bottom:1.5rem}.title{font-size:1.75rem;font-weight:800;color:#111827}.sub{color:#6b7280;font-size:.9rem}.panel{background:#fff;border:1px solid #e5e7eb;border-radius:.75rem;padding:1.5rem}.filters{display:flex;gap:.75rem;margin-bottom:1rem;flex-wrap:wrap}.input{padding:.65rem .9rem;border:1px solid #d1d5db;border-radius:.5rem;min-width:250px}.btn{border:0;border-radius:.5rem;padding:.7rem 1rem;font-weight:700;text-decoration:none;cursor:pointer}.orange{background:#f59e0b;color:#fff}.dark{background:#1f2937;color:#fff}.table{width:100%;border-collapse:collapse}.table th,.table td{text-align:left;padding:.85rem;border-bottom:1px solid #f1f5f9;font-size:.9rem}.table th{font-size:.75rem;color:#64748b;text-transform:uppercase}.link{color:#2563eb;text-decoration:none;font-weight:600}.alert{padding:.75rem 1rem;border-radius:.5rem;margin-bottom:1rem;background:#ecfdf5;color:#065f46}.error{background:#fef2f2;color:#991b1b}@@media(max-width:700px){.header{align-items:flex-start;flex-direction:column}.table-wrap{overflow-x:auto}.table{min-width:650px}}
</style>
<div class="header"><div><h1 class="title">Gestión de clientes</h1><p class="sub">Administra los clientes registrados.</p></div><a asp-action="Create" class="btn orange">+ Nuevo cliente</a></div>
@if(TempData["MensajeExito"] is string ok){<div class="alert">@ok</div>}@if(TempData["MensajeError"] is string error){<div class="alert error">@error</div>}
<div class="panel"><form asp-action="Index" method="get" class="filters"><input type="search" name="busqueda" value="@ViewBag.Busqueda" class="input" placeholder="Buscar por nombre, empresa, teléfono o correo..."/><button class="btn dark" type="submit">Buscar</button><a asp-action="Index" class="link" style="align-self:center">Limpiar</a></form>
<div class="table-wrap"><table class="table"><thead><tr><th>Código</th><th>Cliente</th><th>Empresa</th><th>Teléfono</th><th>Correo</th><th>Acciones</th></tr></thead><tbody>
@if(Model == null || !Model.Any()){<tr><td colspan="6" style="text-align:center;padding:2rem;color:#64748b">No hay clientes registrados.</td></tr>}else{foreach(var cliente in Model){<tr><td><strong>CL-@cliente.IdCliente.ToString("D4")</strong></td><td>@cliente.Nombre</td><td>@cliente.Empresa</td><td>@cliente.Telefono</td><td>@cliente.Correo</td><td><a asp-action="Detalle" asp-route-id="@cliente.IdCliente" class="link">Detalle</a> · <a asp-action="Edit" asp-route-id="@cliente.IdCliente" class="link">Editar</a></td></tr>}}</tbody></table></div></div>
