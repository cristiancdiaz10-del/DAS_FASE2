@model DAS_Proyecto.ViewModels.ClienteDetalleViewModel
@using DAS_Proyecto.Models
@{ ViewData["Title"] = "Detalle del cliente"; }
<style>
.header{display:flex;justify-content:space-between;align-items:center;gap:1rem;margin-bottom:1.5rem}.title{font-size:1.75rem;font-weight:800;color:#111827}.sub{color:#6b7280}.panel{background:#fff;border:1px solid #e5e7eb;border-radius:.75rem;padding:1.5rem;margin-bottom:1.2rem}.grid{display:grid;grid-template-columns:1fr 1fr;gap:1.2rem}.label{display:block;font-size:.8rem;color:#64748b;margin-bottom:.25rem}.value{font-weight:700}.table{width:100%;border-collapse:collapse}.table th,.table td{text-align:left;padding:.8rem;border-bottom:1px solid #f1f5f9}.link{color:#2563eb;text-decoration:none;font-weight:600}.btn{padding:.65rem .9rem;border:1px solid #d1d5db;border-radius:.5rem;text-decoration:none;color:#374151;font-weight:700}@@media(max-width:650px){.grid{grid-template-columns:1fr}.header{align-items:flex-start;flex-direction:column}.table-wrap{overflow-x:auto}.table{min-width:650px}}
</style>
<div class="header"><div><h1 class="title">@Model.Cliente.Nombre</h1><p class="sub">Detalle e historial real del cliente.</p></div><a asp-action="Index" class="btn">Volver a clientes</a></div>
<div class="panel"><h2 style="font-weight:800;margin-bottom:1rem">Información del cliente</h2><div class="grid"><div><span class="label">Código</span><span class="value">CL-@Model.Cliente.IdCliente.ToString("D4")</span></div><div><span class="label">Empresa</span><span class="value">@(Model.Cliente.Empresa ?? "—")</span></div><div><span class="label">Teléfono</span><span class="value">@Model.Cliente.Telefono</span></div><div><span class="label">Correo</span><span class="value">@(Model.Cliente.Correo ?? "—")</span></div><div><span class="label">Dirección</span><span class="value">@(Model.Cliente.Direccion ?? "—")</span></div><div><span class="label">Observaciones</span><span class="value">@(Model.Cliente.Observaciones ?? "—")</span></div></div><div style="margin-top:1rem"><a asp-action="Edit" asp-route-id="@Model.Cliente.IdCliente" class="link">Editar cliente</a></div></div>
<div class="panel"><h2 style="font-weight:800;margin-bottom:1rem">Órdenes de trabajo (@Model.Ordenes.Count)</h2><div class="table-wrap"><table class="table"><thead><tr><th>Código</th><th>Fecha</th><th>Trabajo</th><th>Total</th><th>Estado</th><th></th></tr></thead><tbody>@if(Model.Ordenes.Count==0){<tr><td colspan="6" style="color:#64748b">Este cliente todavía no tiene órdenes registradas.</td></tr>}else{foreach(var orden in Model.Ordenes){<tr><td><strong>@orden.CodigoOrden</strong></td><td>@orden.FechaOrden.ToString("dd/MM/yyyy")</td><td>@orden.Cotizacion?.DescripcionTrabajo</td><td>@orden.Cotizacion?.TotalCotizacion.ToString("C2")</td><td>@orden.Estado</td><td><a asp-controller="Ordenes" asp-action="Detalle" asp-route-id="@orden.IdOrdenTrabajo" class="link">Ver</a></td></tr>}}</tbody></table></div></div>
