@model IEnumerable<DAS_Proyecto.Models.Servicio>
@{ ViewData["Title"] = "Gestión de Servicios"; }
<div class="flex flex-wrap items-center justify-between gap-4 mb-6"><div><h1 class="text-3xl font-extrabold text-gray-900">Gestión de servicios</h1><p class="text-gray-600">Servicios registrados en SQL Server.</p></div><a asp-action="Create" class="bg-amber-500 text-white px-4 py-2 rounded-lg font-bold">+ Nuevo servicio</a></div>
<div class="bg-white border rounded-xl p-5"><form asp-action="Index" method="get" class="flex flex-wrap gap-3 mb-4"><input type="search" name="busqueda" value="@ViewBag.Busqueda" class="border rounded-lg px-3 py-2 min-w-64" placeholder="Buscar servicio o descripción..."/><button type="submit" class="bg-gray-800 text-white rounded-lg px-4 py-2">Buscar</button><a asp-action="Index" class="self-center text-blue-600">Limpiar</a></form>
<table class="table w-full"><thead><tr><th class="text-left p-3">Servicio</th><th class="text-left p-3">Descripción</th><th class="text-left p-3">Precio base</th><th class="text-left p-3">Acciones</th></tr></thead><tbody>@if(Model == null || !Model.Any()){<tr><td colspan="4" class="p-4 text-center text-gray-500">No hay servicios registrados.</td></tr>}else{foreach(var item in Model){<tr class="border-t"><td class="p-3 font-semibold">@item.NombreServicio</td><td class="p-3">@item.Descripcion</td><td class="p-3">@item.PrecioBase.ToString("C2")</td><td class="p-3"><a asp-action="Edit" asp-route-id="@item.IdServicio" class="text-blue-600">Editar</a> <form asp-action="Delete" asp-route-id="@item.IdServicio" method="post" class="inline" onsubmit="return confirm('¿Eliminar este servicio?');">@Html.AntiForgeryToken()<button type="submit" class="text-red-600 ml-2">Eliminar</button></form></td></tr>}}</tbody></table></div>
