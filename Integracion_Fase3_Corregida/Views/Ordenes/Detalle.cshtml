@model DAS_Proyecto.ViewModels.OrdenTrabajoDetalleViewModel
@using DAS_Proyecto.Models
@{ var orden = Model.Orden; ViewData["Title"] = "Detalle de orden"; }
<style>
.page-header{display:flex;justify-content:space-between;align-items:center;gap:1rem;margin-bottom:1.5rem}.page-title{font-size:1.75rem;font-weight:800;color:#111827}.subtitle{color:#6b7280}.panel{background:#fff;border:1px solid #e5e7eb;border-radius:.75rem;padding:1.5rem;margin-bottom:1.25rem}.grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:1rem}.label{display:block;color:#64748b;font-size:.8rem;margin-bottom:.25rem}.value{font-weight:700;color:#111827}.table{width:100%;border-collapse:collapse}.table th,.table td{text-align:left;padding:.75rem;border-bottom:1px solid #f1f5f9}.table th{font-size:.75rem;color:#64748b;text-transform:uppercase}.field{margin-bottom:.8rem}.field label{display:block;font-weight:700;font-size:.85rem;margin-bottom:.35rem}.input{padding:.65rem;border:1px solid #d1d5db;border-radius:.5rem;min-width:180px}.btn{padding:.7rem 1rem;border-radius:.5rem;border:0;font-weight:700;cursor:pointer;text-decoration:none;display:inline-block}.primary{background:#f59e0b;color:#fff}.dark{background:#1f2937;color:#fff}.secondary{background:#fff;border:1px solid #d1d5db;color:#374151}.alert{padding:.75rem 1rem;border-radius:.5rem;margin-bottom:1rem;background:#ecfdf5;color:#065f46}.error{background:#fef2f2;color:#991b1b}.muted{color:#64748b;font-size:.88rem}@@media(max-width:760px){.grid{grid-template-columns:1fr 1fr}.page-header{align-items:flex-start;flex-direction:column}.table-wrap{overflow-x:auto}.table{min-width:650px}}
</style>
<div class="page-header"><div><h1 class="page-title">Orden @orden.CodigoOrden</h1><p class="subtitle">Seguimiento y materiales de la orden de trabajo.</p></div><a asp-action="Index" class="btn secondary">Volver a órdenes</a></div>
@if(TempData["MensajeExito"] is string ok){<div class="alert">@ok</div>}@if(TempData["MensajeError"] is string error){<div class="alert error">@error</div>}
<div class="panel"><h2 style="font-weight:800;margin-bottom:1rem">Información general</h2><div class="grid"><div><span class="label">Cliente</span><span class="value">@orden.Cotizacion?.Cliente?.Nombre</span></div><div><span class="label">Cotización</span><span class="value">@orden.Cotizacion?.CodigoCotizacion</span></div><div><span class="label">Servicio</span><span class="value">@orden.Cotizacion?.Servicio?.NombreServicio</span></div><div><span class="label">Fecha de orden</span><span class="value">@orden.FechaOrden.ToString("dd/MM/yyyy")</span></div><div><span class="label">Estado</span><span class="value">@orden.Estado</span></div><div><span class="label">Entrega estimada</span><span class="value">@(orden.FechaEntregaEstimada?.ToString("dd/MM/yyyy") ?? "No definida")</span></div><div><span class="label">Total</span><span class="value">@(orden.Cotizacion?.TotalCotizacion.ToString("C2") ?? "No disponible")</span></div><div><span class="label">Anticipo requerido</span><span class="value">@orden.AnticipoRequerido.ToString("C2")</span></div><div><span class="label">Total pagado</span><span class="value">@Model.TotalPagado.ToString("C2")</span></div><div><span class="label">Saldo pendiente</span><span class="value">@Model.SaldoPendiente.ToString("C2")</span></div></div>
@if(orden.Estado == EstadoOrden.PendienteAnticipo){<p class="muted" style="margin-top:1rem">Registra el anticipo desde el módulo Pagos. Cuando se cubra el 50 %, cambia el estado a Recepción.</p>}</div>
<div class="panel"><h2 style="font-weight:800;margin-bottom:1rem">Materiales requeridos</h2>
@if(orden.Estado == EstadoOrden.PendienteAnticipo || orden.Estado == EstadoOrden.Recepcion){<form asp-action="AgregarMaterial" method="post" style="display:flex;gap:.8rem;align-items:end;flex-wrap:wrap;margin-bottom:1.2rem">@Html.AntiForgeryToken()<input type="hidden" name="idOrden" value="@orden.IdOrdenTrabajo"/><div class="field"><label>Material</label><select name="idMaterial" class="input" required><option value="">Seleccionar material</option>@foreach(var m in Model.Materiales){<option value="@m.IdMaterial">@m.NombreMaterial (@m.CantidadDisponible.ToString("N2") @m.UnidadMedida)</option>}</select></div><div class="field"><label>Cantidad</label><input type="number" step="0.01" min="0.01" name="cantidadUtilizada" class="input" required/></div><button type="submit" class="btn dark">Agregar material</button></form>}
<div class="table-wrap"><table class="table"><thead><tr><th>Material</th><th>Cantidad</th><th>Precio unitario histórico</th><th>Subtotal</th></tr></thead><tbody>@if(Model.Detalles.Count==0){<tr><td colspan="4" class="muted">Todavía no se han agregado materiales.</td></tr>}else{foreach(var d in Model.Detalles){<tr><td>@d.Material?.NombreMaterial</td><td>@d.CantidadUtilizada.ToString("N2") @d.Material?.UnidadMedida</td><td>@d.PrecioUnitario.ToString("C2")</td><td>@d.Subtotal.ToString("C2")</td></tr>}}</tbody></table></div>
<p class="muted" style="margin-top:.8rem">Las existencias se descuentan en una sola operación al iniciar producción. Si falta algún material, no se realiza ningún descuento.</p></div>
<div class="panel"><h2 style="font-weight:800;margin-bottom:1rem">Actualizar estado</h2>@{ string? siguiente = orden.Estado switch { EstadoOrden.PendienteAnticipo => "Recepcion", EstadoOrden.Recepcion => "EnProceso", EstadoOrden.EnProceso => "Listo", EstadoOrden.Listo => "Entregado", _ => null }; string texto = siguiente switch { "Recepcion" => "Recepción", "EnProceso" => "En proceso", "Listo" => "Listo", "Entregado" => "Entregado", _ => "" }; }
@if(siguiente != null){<form asp-action="ActualizarEstado" method="post">@Html.AntiForgeryToken()<input type="hidden" name="id" value="@orden.IdOrdenTrabajo"/><input type="hidden" name="nuevoEstado" value="@siguiente"/><p class="muted" style="margin-bottom:.8rem">Siguiente etapa: <strong>@texto</strong></p><button class="btn primary" type="submit">Avanzar a @texto</button></form>}else{<p class="muted">La orden ya está entregada.</p>}</div>
