@model DAS_Proyecto.ViewModels.CrearOrdenViewModel
@{ ViewData["Title"] = "Generar orden de trabajo"; }
<style>
.page-title{font-size:1.75rem;font-weight:800;color:#111827;margin-bottom:.3rem}.subtitle{color:#6b7280;margin-bottom:1.5rem}.panel{background:#fff;border:1px solid #e5e7eb;border-radius:.75rem;padding:2rem;max-width:760px}.grid{display:grid;grid-template-columns:1fr 1fr;gap:1rem}.field{margin-bottom:1rem}.field label{display:block;font-weight:700;margin-bottom:.35rem}.input{width:100%;padding:.7rem;border:1px solid #d1d5db;border-radius:.5rem}.actions{display:flex;gap:.75rem;margin-top:1.5rem}.btn{padding:.75rem 1rem;border-radius:.5rem;font-weight:700;text-decoration:none;border:0;cursor:pointer}.primary{background:#f59e0b;color:#fff}.secondary{border:1px solid #d1d5db;color:#374151;background:#fff}.validation-summary-errors{color:#b91c1c}@@media(max-width:650px){.grid{grid-template-columns:1fr}}
</style>
<h1 class="page-title">Generar orden de trabajo</h1><p class="subtitle">La orden se creará a partir de una cotización aceptada y conservará su importe.</p>
<div class="panel"><form asp-action="CrearDesdeCotizacion" method="post">@Html.AntiForgeryToken()<input asp-for="IdCotizacion" type="hidden"/><div asp-validation-summary="ModelOnly" class="validation-summary-errors"></div>
<div class="grid"><div class="field"><label>Cotización</label><input class="input" value="@Model.CodigoCotizacion" readonly/></div><div class="field"><label>Cliente</label><input class="input" value="@Model.Cliente" readonly/></div><div class="field"><label>Total aceptado</label><input class="input" value="@Model.Total.ToString("C2")" readonly/></div><div class="field"><label asp-for="FechaEntregaEstimada">Fecha estimada de entrega</label><input asp-for="FechaEntregaEstimada" type="date" class="input"/></div></div>
<div class="field"><label>Descripción del trabajo</label><textarea class="input" rows="3" readonly>@Model.Trabajo</textarea></div><p style="color:#6b7280;font-size:.88rem">El anticipo requerido se calcula automáticamente como el 50 % del total aceptado.</p><div class="actions"><a asp-controller="Cotizaciones" asp-action="Cotizaciones" class="btn secondary">Cancelar</a><button class="btn primary" type="submit">Crear orden</button></div></form></div>
