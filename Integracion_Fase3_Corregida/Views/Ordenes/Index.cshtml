@model DAS_Proyecto.ViewModels.OrdenTrabajoListadoViewModel
@using DAS_Proyecto.Models
@{ ViewData["Title"] = "Órdenes de trabajo"; var estados = Enum.GetValues<EstadoOrden>(); }
<style>
.page-header{display:flex;justify-content:space-between;align-items:center;gap:1rem;margin-bottom:1.5rem}.page-title{font-size:1.75rem;font-weight:800;color:#111827}.subtitle{color:#6b7280;font-size:.9rem}.panel{background:#fff;border:1px solid #e5e7eb;border-radius:.75rem;padding:1.5rem;box-shadow:0 1px 3px rgba(0,0,0,.04)}.filters{display:flex;gap:.75rem;margin-bottom:1rem;flex-wrap:wrap}.control{padding:.65rem .9rem;border:1px solid #d1d5db;border-radius:.5rem;background:#fff}.btn-dark{background:#1f2937;color:#fff;border:0;border-radius:.5rem;padding:.7rem 1rem}.link{color:#2563eb;text-decoration:none;font-weight:600}.table{width:100%;border-collapse:collapse}.table th,.table td{text-align:left;padding:.85rem;border-bottom:1px solid #f1f5f9;font-size:.9rem}.table th{font-size:.75rem;text-transform:uppercase;color:#64748b}.badge{display:inline-block;border-radius:999px;padding:.3rem .7rem;background:#e0e7ff;color:#3730a3;font-size:.78rem;font-weight:700}.ok{background:#dcfce7;color:#166534}.warn{background:#fef3c7;color:#92400e}.alert{padding:.75rem 1rem;border-radius:.5rem;margin-bottom:1rem;background:#ecfdf5;color:#065f46}.error{background:#fef2f2;color:#991b1b}@@media(max-width:700px){.table-wrap{overflow-x:auto}.table{min-width:820px}.page-header{align-items:flex-start;flex-direction:column}}
</style>
<div class="page-header"><div><h1 class="page-title">Órdenes de trabajo</h1><p class="subtitle">Órdenes creadas a partir de cotizaciones aceptadas.</p></div><a asp-controller="Cotizaciones" asp-action="Cotizaciones" class="link">Ir a cotizaciones aceptadas</a></div>
@if (TempData["MensajeExito"] is string ok){<div class="alert">@ok</div>}
@if (TempData["MensajeError"] is string error){<div class="alert error">@error</div>}
<div class="panel">
<form asp-action="Index" method="get" class="filters"><input class="control" type="search" name="busqueda" value="@Model.Busqueda" placeholder="Buscar por código o cliente..." style="min-width:260px;flex:1"/><select class="control" name="estado"><option value="">Todos los estados</option>@foreach(var estado in estados){if(Model.EstadoSeleccionado == estado.ToString()){<option value="@estado" selected>@estado</option>}else{<option value="@estado">@estado</option>}}</select><button class="btn-dark" type="submit">Buscar / Filtrar</button><a asp-action="Index" class="link" style="align-self:center">Limpiar</a></form>
<div class="table-wrap"><table class="table"><thead><tr><th>Código</th><th>Cliente</th><th>Trabajo</th><th>Fecha</th><th>Total</th><th>Pagado</th><th>Estado</th><th>Acciones</th></tr></thead><tbody>
@if(Model.Ordenes.Count == 0){<tr><td colspan="8" style="text-align:center;padding:2rem;color:#64748b">No hay órdenes que coincidan con los filtros.</td></tr>}
else{foreach(var orden in Model.Ordenes){var total = orden.Cotizacion?.TotalCotizacion ?? 0m; var pagado = orden.Pagos.Sum(p => p.MontoPago);<tr><td><strong>@orden.CodigoOrden</strong></td><td>@orden.Cotizacion?.Cliente?.Nombre</td><td>@orden.Cotizacion?.DescripcionTrabajo</td><td>@orden.FechaOrden.ToString("dd/MM/yyyy")</td><td>@total.ToString("C2")</td><td>@pagado.ToString("C2")</td><td><span class="badge @(orden.Estado == EstadoOrden.Entregado ? "ok" : orden.Estado == EstadoOrden.PendienteAnticipo ? "warn" : "")">@orden.Estado</span></td><td><a asp-action="Detalle" asp-route-id="@orden.IdOrdenTrabajo" class="link">Ver detalle</a></td></tr>}}</tbody></table></div>
</div>
