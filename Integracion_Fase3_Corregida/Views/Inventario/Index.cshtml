@model IReadOnlyList<DAS_Proyecto.Models.Material>
@{
    ViewData["Title"] = "Inventario";
}
<style>
.page-header{display:flex;justify-content:space-between;align-items:center;gap:1rem;margin-bottom:1.5rem}.page-title{font-size:1.75rem;font-weight:800;color:#111827}.subtitle{color:#6b7280;font-size:.9rem}.panel{background:#fff;border:1px solid #e5e7eb;border-radius:.75rem;padding:1.5rem;box-shadow:0 1px 3px rgba(0,0,0,.04)}.filters{display:flex;gap:.75rem;margin-bottom:1rem;flex-wrap:wrap}.control{padding:.65rem .9rem;border:1px solid #d1d5db;border-radius:.5rem;background:#fff}.btn-main{background:#f59e0b;color:#fff;text-decoration:none;border:0;border-radius:.5rem;padding:.7rem 1rem;font-weight:700}.btn-dark{background:#1f2937;color:white;border:0;border-radius:.5rem;padding:.7rem 1rem}.table{width:100%;border-collapse:collapse}.table th,.table td{text-align:left;padding:.85rem;border-bottom:1px solid #f1f5f9;font-size:.9rem}.table th{font-size:.75rem;text-transform:uppercase;color:#64748b}.link{color:#2563eb;text-decoration:none;font-weight:600}.danger{color:#b91c1c;background:none;border:0;font-weight:600;cursor:pointer}.alert{padding:.75rem 1rem;border-radius:.5rem;margin-bottom:1rem;background:#ecfdf5;color:#065f46}.error{background:#fef2f2;color:#991b1b}@@media(max-width:700px){.table-wrap{overflow-x:auto}.table{min-width:720px}.page-header{align-items:flex-start;flex-direction:column}}
</style>
<div class="page-header"><div><h1 class="page-title">Inventario</h1><p class="subtitle">Materiales y existencias registradas en la base de datos.</p></div><a asp-action="Nuevo" class="btn-main">+ Nuevo material</a></div>
@if (TempData["MensajeExito"] is string ok){<div class="alert">@ok</div>}
@if (TempData["MensajeError"] is string error){<div class="alert error">@error</div>}
<div class="panel">
    <form asp-action="Index" method="get" class="filters">
        <input class="control" type="search" name="busqueda" value="@ViewBag.Busqueda" placeholder="Buscar por código, material o unidad..." style="min-width:280px;flex:1" />
        <button class="btn-dark" type="submit">Buscar</button>
        <a asp-action="Index" class="link" style="align-self:center">Limpiar</a>
    </form>
    <div class="table-wrap"><table class="table"><thead><tr><th>Código</th><th>Material</th><th>Existencias</th><th>Unidad</th><th>Costo unitario</th><th>Acciones</th></tr></thead><tbody>
    @if (Model.Count == 0){<tr><td colspan="6" style="text-align:center;color:#6b7280;padding:2rem">No hay materiales que coincidan con la búsqueda.</td></tr>}
    else {foreach(var item in Model){<tr><td><strong>@item.CodigoMaterial</strong></td><td>@item.NombreMaterial</td><td>@item.CantidadDisponible.ToString("N2")</td><td>@item.UnidadMedida</td><td>@item.CostoUnitario.ToString("C2")</td><td><a asp-action="EditarMaterial" asp-route-id="@item.IdMaterial" class="link">Editar</a> <form asp-action="EliminarMaterial" asp-route-id="@item.IdMaterial" method="post" style="display:inline" onsubmit="return confirm('¿Eliminar este material?')">@Html.AntiForgeryToken()<button class="danger" type="submit">Eliminar</button></form></td></tr>}}
    </tbody></table></div>
</div>
