@model DAS_Proyecto.ViewModels.MaterialViewModel
@{ ViewData["Title"] = "Nuevo material"; }
<style>
.page-header{display:flex;justify-content:space-between;align-items:center;margin-bottom:1.5rem}.page-title{font-size:1.75rem;font-weight:800;color:#111827}.subtitle{color:#6b7280}.panel{background:#fff;border:1px solid #e5e7eb;border-radius:.75rem;padding:2rem;max-width:900px}.grid{display:grid;grid-template-columns:1fr 1fr;gap:1rem}.field{margin-bottom:1.1rem}.field label{display:block;font-weight:700;font-size:.88rem;margin-bottom:.4rem}.input{width:100%;padding:.7rem .85rem;border:1px solid #d1d5db;border-radius:.5rem}.actions{display:flex;gap:1rem;margin-top:1.5rem}.btn{padding:.75rem 1rem;border-radius:.5rem;font-weight:700;text-decoration:none;border:0;cursor:pointer}.primary{background:#f59e0b;color:white}.secondary{background:#fff;color:#374151;border:1px solid #d1d5db}.validation-summary-errors,.field-validation-error{color:#b91c1c;font-size:.85rem}@@media(max-width:700px){.grid{grid-template-columns:1fr}.page-header{align-items:flex-start;flex-direction:column}}
</style>
<div class="page-header"><div><h1 class="page-title">Nuevo material</h1><p class="subtitle">Registra un material en SQL Server.</p></div><a asp-action="Index" class="btn secondary">Volver</a></div>
<div class="panel"><form asp-action="AddInven" method="post">@Html.AntiForgeryToken()<div asp-validation-summary="ModelOnly" class="validation-summary-errors"></div>
<div class="grid"><div class="field"><label asp-for="CodigoMaterial"></label><input asp-for="CodigoMaterial" class="input" placeholder="MAT-004"/><span asp-validation-for="CodigoMaterial" class="field-validation-error"></span></div><div class="field"><label asp-for="NombreMaterial"></label><input asp-for="NombreMaterial" class="input"/><span asp-validation-for="NombreMaterial" class="field-validation-error"></span></div><div class="field"><label asp-for="CantidadDisponible"></label><input asp-for="CantidadDisponible" type="number" min="0" step="0.01" class="input"/><span asp-validation-for="CantidadDisponible" class="field-validation-error"></span></div><div class="field"><label asp-for="UnidadMedida"></label><select asp-for="UnidadMedida" class="input"><option value="">Seleccionar...</option><option>Unidad</option><option>Metro</option><option>Rollo</option><option>Litro</option><option>Kilogramo</option></select><span asp-validation-for="UnidadMedida" class="field-validation-error"></span></div><div class="field"><label asp-for="CostoUnitario"></label><input asp-for="CostoUnitario" type="number" min="0" step="0.01" class="input"/><span asp-validation-for="CostoUnitario" class="field-validation-error"></span></div></div>
<div class="field"><label asp-for="Descripcion"></label><textarea asp-for="Descripcion" class="input" rows="3"></textarea></div><div class="actions"><a asp-action="Index" class="btn secondary">Cancelar</a><button type="submit" class="btn primary">Guardar material</button></div></form></div>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
