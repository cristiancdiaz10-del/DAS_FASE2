<Project Sdk="Microsoft.NET.Sdk.Web">

	<PropertyGroup>
		<TargetFramework>net10.0</TargetFramework>
		<Nullable>enable</Nullable>
		<ImplicitUsings>enable</ImplicitUsings>
		<RootNamespace>DAS_Proyecto</RootNamespace>
		<NuGetAudit>false</NuGetAudit>

		<!-- Excluir el proyecto de pruebas de los archivos del proyecto web -->
		<DefaultItemExcludes>$(DefaultItemExcludes);PruebasPago/**</DefaultItemExcludes>
	</PropertyGroup>

	<ItemGroup>
		<Compile Remove="PruebasPago/**/*.cs" />
		<Content Remove="PruebasPago/**/*" />
		<EmbeddedResource Remove="PruebasPago/**/*" />
		<None Remove="PruebasPago/**/*" />
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="Microsoft.Data.SqlClient" Version="6.1.8" />
		<PackageReference Include="Microsoft.EntityFrameworkCore" Version="10.0.15" />
		<PackageReference Include="Microsoft.EntityFrameworkCore.SqlServer" Version="10.0.15" />

		<PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.15">
			<IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
			<PrivateAssets>all</PrivateAssets>
		</PackageReference>

		<PackageReference Include="Microsoft.EntityFrameworkCore.Tools" Version="10.0.15">
			<IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
			<PrivateAssets>all</PrivateAssets>
		</PackageReference>
	</ItemGroup>

</Project>